# Copy this file to .env (or set these as real environment variables on your host)

# PostgreSQL connection string.
# Local example:
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/securevault
# Render / Railway / Supabase / Neon: copy the connection string they give you.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/securevault

# Optional but recommended in production: a stable secret key so sessions
# survive redeploys (otherwise a random one is generated and saved to
# instance/secret.key, which is lost if the disk isn't persistent).
FLASK_SECRET_KEY=change-me-to-a-random-64-char-hex-string

# Encrypts every uploaded document at rest (AES via Fernet). Strongly
# recommended in production for the same reason as FLASK_SECRET_KEY above:
# without this set, a key is generated once and saved to
# instance/file_encryption.key, which most hosting platforms wipe on
# redeploy — losing it makes previously-uploaded documents unreadable.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FILE_ENCRYPTION_KEY=

PORT=5000

# Google Sign-In (Google Identity Services). Create an OAuth 2.0 Client ID
# of type "Web application" in Google Cloud Console > APIs & Services >
# Credentials, add your site's origin(s) under "Authorized JavaScript
# origins" (e.g. http://localhost:5000 and your production domain), and
# paste the Client ID below. No client secret is needed for this flow —
# the ID token is verified server-side against Google's public keys.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Vault AI (the "Ask your documents" feature). Optional — without this key,
# Vault AI still works but falls back to plain keyword matching instead of
# a real LLM answer. Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
AI_MODEL=llama-3.3-70b-versatile
AI_FALLBACK_MODEL=llama-3.1-8b-instant

# How long (seconds) to wait on any single outbound AI request before
# giving up and trying the next option (fallback model / alternative
# provider / local keyword matcher). Keeps a slow or rate-limited call
# from making the whole "Ask your documents" feature feel stuck.
AI_REQUEST_TIMEOUT_SECONDS=20

# Optional: an ADDITIONAL provider tried only if Groq isn't configured or
# every Groq attempt fails. Any OpenAI-compatible chat-completions endpoint
# works here — leave unset to skip this entirely. A few free-tier options:
#   OpenRouter (many free models): https://openrouter.ai/api/v1/chat/completions
#   Google Gemini (OpenAI-compat): https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
#   Together AI:                   https://api.together.xyz/v1/chat/completions
#   Local Ollama:                  http://localhost:11434/v1/chat/completions
AI_ALT_API_KEY=
AI_ALT_BASE_URL=
AI_ALT_MODEL=


# Resend HTTPS API for Email Verification & Password Reset Codes.
# Works reliably on Render Free and cloud hosts without requiring outbound SMTP port 587.
# Get an API key at https://resend.com/api-keys
# MAIL_FROM can be onboarding@resend.dev (for testing) or any sender on your verified domain.
RESEND_API_KEY=re_your-resend-api-key
MAIL_FROM=SecureVault AI <support@securevault.de5.net>

# AES-256-GCM key for encrypting extracted document text stored in PostgreSQL.
# SecureVault encrypts both uploaded files on disk AND the text extracted from
# those files in the database — this key protects the database copy.
#
# Generate a secure 32-byte key with:
#   python -c "import os, base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
#
# Rules:
#   - NEVER reuse FLASK_SECRET_KEY, FILE_ENCRYPTION_KEY, GROQ_API_KEY, or any other secret here.
#   - NEVER commit a real key to version control (.env is already in .gitignore).
#   - Keep it stable — losing the key makes all existing RAG chunks unreadable.
#   - In production, inject via your host's secret manager (Render, Railway, Fly.io, etc.).
DOCUMENT_TEXT_ENCRYPTION_KEY=your-base64-encoded-32-byte-key
